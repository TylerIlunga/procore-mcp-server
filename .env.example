# Procore OAuth credentials (from Procore Developer Portal)
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=

# Default company ID (integer) — used as Procore-Company-Id header
PROCORE_COMPANY_ID=

# Procore environment: "sandbox" or "production". If unset, the server uses PRODUCTION
# (login.procore.com / api.procore.com). Set this explicitly.
# PROCORE_ENV=sandbox

# Auth grant: "authorization_code" (default; interactive, run `npm run auth` once) or
# "client_credentials" (Developer Managed Service Account app: no browser step, the
# token is held in memory and re-minted on expiry).
# PROCORE_GRANT_TYPE=authorization_code

# Optional: custom token storage path (default: ~/.procore-mcp/tokens.json)
# PROCORE_TOKEN_PATH=
