{"operationId":"RestV20CompaniesCompanyIdProjectsProjectIdBudgetColumnsBudgetColumnIdDirectEntriesWbsCodeIdDelete","method":"DELETE","path":"/rest/v2.0/companies/{company_id}/projects/{project_id}/budget_columns/{budget_column_id}/direct_entries/{wbs_code_id}","summary":"Clear a Direct Entry value for a Budget Column and WBS Code","description":"Remove the direct entry stored for a budget column and WBS code. For a quantity column this clears both the quantity and its unit of measure. A quantity with no unit of measure can be aggregated.","tag":"Construction Financials/Budget/direct-entries","deprecated":false,"parameters":[{"name":"company_id","in":"path","required":true,"description":"Unique identifier for the company.","schema":{"type":"string"}},{"name":"project_id","in":"path","required":true,"description":"Unique identifier for the project.","schema":{"type":"string"}},{"name":"budget_column_id","in":"path","required":true,"description":"ID of the budget column","schema":{"type":"string"}},{"name":"wbs_code_id","in":"path","required":true,"description":"ID of the WBS code","schema":{"type":"string"}}],"responses":{"202":{"description":"Direct entry clear was accepted."},"403":{"description":"Forbidden"},"422":{"description":"Unprocessable Entity"}}}