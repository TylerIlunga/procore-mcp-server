{"operationId":"RestV20CompaniesCompanyIdProjectsProjectIdExternalSubmittalsIdAdvancedExportsPost","method":"POST","path":"/rest/v2.0/companies/{company_id}/projects/{project_id}/external_submittals/{id}/advanced_exports","summary":"Create an advanced export for an External Submittal.","description":"Kicks off an advanced export of the specified External Submittal with the selected format and attachments. ZIP exports and multi-file PDF exports are generated asynchronously and do not return a download URL. A PDF export containing only the cover sheet is generated synchronously and returns a download URL.","tag":"Project Management/Submittals/external-submittals","deprecated":false,"parameters":[{"name":"company_id","in":"path","required":true,"description":"Unique identifier for the company.","schema":{"type":"string"}},{"name":"project_id","in":"path","required":true,"description":"Unique identifier for the project.","schema":{"type":"string"}},{"name":"id","in":"path","required":true,"description":"External Submittal ID","schema":{"type":"string"}}],"responses":{"200":{"description":"OK","schema":{"type":"object","properties":{"data":{"type":"object","description":"Export result data.","properties":{"message":{"type":"string","description":"Success message."},"url":{"type":"string","description":"URL to download the exported file (only present when the export is generated synchronously)."}}}}}},"401":{"description":"Unauthorized"},"403":{"description":"Forbidden"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Internal Server Error"},"default":{"description":"Unexpected error"}},"requestBody":{"contentType":"application/json","required":true,"schema":{"type":"object","required":["format","options"],"properties":{"format":{"type":"string","description":"Export file format.","enum":["pdf","zip"]},"options":{"type":"object","description":"Advanced export options.","properties":{"files":{"type":"array","description":"IDs of the External Submittal attachments to include in the export. Include the cover sheet slug to prepend a cover sheet.","items":{"type":"string"}}}}}}}}